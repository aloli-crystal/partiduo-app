#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# partiduo-fleet — exploitation du parc d'instances Partiduo sur des serveurs
# FreeBSD, où Partiduo est installé par paquet (dépôt pkg.aloli.net, overlay
# aloli-ports) : partiduo-app (branche production) ou partiduo-app-devel
# (branche development), qui cohabitent. Provisionnement, état, sauvegardes,
# retrait. La mise à jour des paquets relève de beryl (pkg upgrade) ; le
# script rc.d migre chaque instance à son démarrage (D-PKG-003).
#
# Par défaut, RIEN n'est exécuté : chaque commande affiche le plan (commandes
# locales et distantes). `--execute` l'exécute réellement.
#
# Voir deploy/README.adoc.
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP_ROOT=$(CDPATH= cd -- "$HERE/../.." && pwd)

usage() {
  cat <<'EOF'
Usage : partiduo-fleet [--config FICHIER] [--execute] <commande> [arguments]

Commandes :
  inventory                          liste les instances de l'inventaire
  provision SERVEUR DOSSIER [--version app|devel] [OPTIONS…]
                                     crée l'instance (partiduo-provision du paquet) et
                                     l'installe ; version : paquet qui la sert (défaut : app)
  status [DOSSIER]                   paquet, version et état du service de chaque instance
  backup DOSSIER | --all             sauvegarde la base (pg_dump -Fc) et les pièces jointes
  restore DOSSIER FICHIER            restaure une sauvegarde, base et pièces jointes
                                     (FICHIER.dump et FICHIER.media.tar.gz, service arrêté)
  retire DOSSIER                     sauvegarde puis retire l'instance (base conservée)

Options :
  --config FICHIER   configuration du parc (défaut : $PARTIDUO_FLEET_CONFIG ou deploy/fleet.conf)
  --execute          exécute réellement (sinon : affiche le plan)
  -h, --help         cette aide
EOF
}

die() {
  echo "partiduo-fleet : $*" >&2
  exit 1
}

EXECUTE=0
CONFIG="${PARTIDUO_FLEET_CONFIG:-$APP_ROOT/deploy/fleet.conf}"

while [ $# -gt 0 ]; do
  case "$1" in
    --execute) EXECUTE=1 ;;
    --config) [ $# -ge 2 ] || die "--config : fichier manquant"; CONFIG="$2"; shift ;;
    --config=*) CONFIG="${1#*=}" ;;
    -h | --help) usage; exit 0 ;;
    -*) die "option inconnue : $1" ;;
    *) break ;;
  esac
  shift
done

[ $# -ge 1 ] || { usage >&2; exit 1; }
COMMAND="$1"
shift

[ -f "$CONFIG" ] || die "configuration introuvable : $CONFIG (voir deploy/fleet.conf.example)"

# Valeurs par défaut (chemins FreeBSD), puis configuration du parc (fichier shell).
PARTIDUO_DOMAIN="partiduo.example"
ETC_DIR="/usr/local/etc/partiduo"
DATA_DIR="/var/db/partiduo"
BACKUP_DIR="/var/backups/partiduo"
SYSTEM_USER="partiduo"
PG_SOCKET="/tmp"
PG_OWNER="partiduo"
INVENTORY="$APP_ROOT/deploy/inventory"
SUDO="sudo"
ACME_EMAIL=""
ACME_WEBROOT="/usr/local/www/letsencrypt"
ACME_STAGING=0
# shellcheck disable=SC1090
. "$CONFIG"

# L'inventaire est relatif au fichier de configuration.
case "$INVENTORY" in /*) ;; *) INVENTORY="$(CDPATH= cd -- "$(dirname -- "$CONFIG")" && pwd)/$INVENTORY" ;; esac

# --- Exécution -----------------------------------------------------------------

mode_label() {
  [ "$EXECUTE" = 1 ] && echo "exécution" || echo "plan (ajoutez --execute pour exécuter)"
}

# Commande locale.
local_run() {
  printf '[local] %s\n' "$*"
  [ "$EXECUTE" = 0 ] || sh -c "$*"
}

# Commande distante (chaîne shell exécutée par ssh sur SERVEUR).
remote() {
  server="$1"
  shift
  printf '[%s] %s\n' "$server" "$*"
  [ "$EXECUTE" = 0 ] || ssh -o BatchMode=yes "$server" "$*"
}

# --- Paquets ---------------------------------------------------------------------
# Chaque version est installée dans son propre répertoire, avec son script
# rc.d multi-instances (aloli-ports, finance/partiduo-app).

check_kind() {
  case "$1" in app | devel) ;; *) die "version invalide : « $1 » (app ou devel)" ;; esac
}
package_of() { [ "$1" = devel ] && echo partiduo-app-devel || echo partiduo-app; }
home_of() { [ "$1" = devel ] && echo /usr/local/lib/partiduo-devel || echo /usr/local/lib/partiduo; }
rc_of() { [ "$1" = devel ] && echo partiduo_devel || echo partiduo; }
manage_of() { echo "$(home_of "$1")/bin/partiduo-manage"; }

# --- Inventaire -----------------------------------------------------------------
# Une ligne par instance : « <dossier> <serveur ssh> [app|devel] [commentaire] ».
# C'est l'inventaire des instances, hors application (ADR-001 D2 : la table
# ac_dossier de l'application d'origine disparaît). Sans version : app.

inventory_lines() {
  [ -f "$INVENTORY" ] || return 0
  sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$INVENTORY"
}

server_of() {
  inventory_lines | awk -v d="$1" '$1 == d { print $2; exit }'
}

kind_of() {
  inventory_lines | awk -v d="$1" '$1 == d { print ($3 == "devel" ? "devel" : "app"); exit }'
}

require_instance() {
  server=$(server_of "$1")
  [ -n "$server" ] || die "instance inconnue de l'inventaire : $1"
  echo "$server"
}

check_dossier() {
  printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9-]{0,39}$' || die "dossier invalide : « $1 »"
}

env_file() { echo "$ETC_DIR/$1.env"; }

# Charge l'environnement de l'instance dans le shell distant.
load_env() { echo "set -a && . $(env_file "$1") && set +a"; }

# --- Commandes ------------------------------------------------------------------

cmd_inventory() {
  echo "# Inventaire : $INVENTORY"
  inventory_lines | awk '{ printf "%-24s %-24s %s\n", $1, $2, ($3 == "devel" ? "devel" : "app") }'
}

cmd_provision() {
  [ $# -ge 2 ] || die "usage : provision SERVEUR DOSSIER [--version app|devel] [options de partiduo-provision…]"
  server="$1"
  dossier="$2"
  shift 2
  check_dossier "$dossier"
  [ -z "$(server_of "$dossier")" ] || die "instance déjà dans l'inventaire : $dossier"
  kind=app
  args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) [ $# -ge 2 ] || die "--version : valeur manquante"; kind="$2"; shift ;;
      --version=*) kind="${1#*=}" ;;
      *) args="$args '$(printf '%s' "$1" | sed "s/'/'\\\\''/g")'" ;;
    esac
    shift
  done
  check_kind "$kind"
  home=$(home_of "$kind")
  work="/tmp/partiduo-provision-$dossier"
  acme=""
  [ -z "$ACME_EMAIL" ] || acme=" --acme-email=$ACME_EMAIL"
  [ "$ACME_STAGING" = 0 ] || acme="$acme --acme-staging"
  echo "# Provisionnement de $dossier sur $server, paquet $(package_of "$kind") ($(mode_label))"
  remote "$server" "test -x $home/bin/partiduo-provision || { echo 'paquet $(package_of "$kind") absent' >&2; exit 1; }"
  remote "$server" "$SUDO -u postgres createuser --createdb --no-superuser $PG_OWNER 2>/dev/null || true"
  remote "$server" "$SUDO -u $SYSTEM_USER $home/bin/partiduo-provision --version=$kind" \
    "--domain=$PARTIDUO_DOMAIN --owner=$PG_OWNER --pg-socket=$PG_SOCKET" \
    "--data-dir=$DATA_DIR --etc-dir=$ETC_DIR --system-user=$SYSTEM_USER --output-dir=$work" \
    "--acme-webroot=$ACME_WEBROOT$acme$args $dossier"
  remote "$server" "cd $work/$dossier && $SUDO sh INSTALL.txt && $SUDO rm -rf $work"
  local_run "printf '%s %s %s\\n' '$dossier' '$server' '$kind' >> '$INVENTORY'"
}

backup_cmd() {
  server="$1"
  dossier="$2"
  label="$3"
  # Base (pg_dump -Fc) et pièces jointes, sous un même nom : la liste des
  # fichiers vient de l'instance elle-même (interface en ligne de commande
  # d'instance, `backup-plan`, doc/api/instance-cli.adoc), relevée avant ET
  # après pg_dump : l'archive porte l'union des deux listes, donc toute pièce
  # déposée ou supprimée pendant la sauvegarde que la base peut citer
  # (D-AFN-012). Seules les pièces encore présentes sont archivées : une
  # pièce supprimée entre-temps ne fait pas échouer la sauvegarde (bsdtar n'a
  # pas l'option --ignore-failed-read de GNU tar).
  remote "$server" "$SUDO install -d -o $SYSTEM_USER -g $SYSTEM_USER -m 750 $BACKUP_DIR/$dossier" \
    "&& $SUDO -u $SYSTEM_USER sh -c '$(load_env "$dossier") && f=$BACKUP_DIR/$dossier/$label" \
    "&& m=$(manage_of "$(kind_of "$dossier")")" \
    "&& \$m instance backup-plan --list-file \$f.files.before >/dev/null" \
    "&& pg_dump -Fc -d \"\$DATABASE_URL\" -f \$f.dump" \
    "&& \$m instance backup-plan --list-file \$f.files.after >\$f.plan.json" \
    "&& sort -u \$f.files.before \$f.files.after >\$f.files && rm -f \$f.files.before \$f.files.after" \
    "&& { while IFS= read -r p; do [ -e \"\$PARTIDUO_MEDIA_ROOT/\$p\" ] && printf \"%s\\\\n\" \"\$p\"; done <\$f.files >\$f.files.present || true; }" \
    "&& tar -C \"\$PARTIDUO_MEDIA_ROOT\" -czf \$f.media.tar.gz -T \$f.files.present'"
}

# Base, puis pièces jointes : l'archive <libellé>.media.tar.gz prise avec la
# sauvegarde <libellé>.dump est extraite sous $PARTIDUO_MEDIA_ROOT si elle
# existe (les pièces présentes sont remplacées, aucune n'est supprimée).
restore_cmd() {
  server="$1"
  dossier="$2"
  file="$3"
  remote "$server" "$SUDO -u $SYSTEM_USER sh -c '$(load_env "$dossier") && f=$file" \
    "&& pg_restore --clean --if-exists --no-owner -d \"\$DATABASE_URL\" \$f" \
    "&& a=\${f%.dump}.media.tar.gz && if [ -f \"\$a\" ]; then mkdir -p \"\$PARTIDUO_MEDIA_ROOT\"" \
    "&& tar -C \"\$PARTIDUO_MEDIA_ROOT\" -xzf \"\$a\"; else echo \"pièces jointes : \$a absente\" >&2; fi'"
}

cmd_status() {
  echo "# État du parc ($(mode_label))"
  if [ $# -ge 1 ]; then
    check_dossier "$1"
    list="$1"
  else
    list=$(inventory_lines | awk '{ print $1 }')
  fi
  for dossier in $list; do
    server=$(require_instance "$dossier")
    kind=$(kind_of "$dossier")
    remote "$server" "printf '%-24s %-20s %-16s %s\\n' $dossier $(package_of "$kind") \$(pkg query %v $(package_of "$kind"))" \
      "\"\$($SUDO service $(rc_of "$kind") status $dossier 2>&1 | head -n 1)\""
  done
}

cmd_backup() {
  [ $# -eq 1 ] || die "usage : backup DOSSIER | --all"
  if [ "$1" = "--all" ]; then
    list=$(inventory_lines | awk '{ print $1 }')
  else
    check_dossier "$1"
    list="$1"
  fi
  echo "# Sauvegarde ($(mode_label))"
  for dossier in $list; do
    server=$(require_instance "$dossier")
    backup_cmd "$server" "$dossier" "manual-\$(date +%Y%m%d-%H%M%S)"
  done
}

cmd_restore() {
  [ $# -eq 2 ] || die "usage : restore DOSSIER FICHIER"
  dossier="$1"
  check_dossier "$dossier"
  server=$(require_instance "$dossier")
  rc=$(rc_of "$(kind_of "$dossier")")
  echo "# Restauration de $dossier depuis $2 ($(mode_label))"
  remote "$server" "$SUDO service $rc stop $dossier"
  restore_cmd "$server" "$dossier" "$2"
  remote "$server" "$SUDO service $rc start $dossier"
}

cmd_retire() {
  [ $# -eq 1 ] || die "usage : retire DOSSIER"
  dossier="$1"
  check_dossier "$dossier"
  server=$(require_instance "$dossier")
  rc=$(rc_of "$(kind_of "$dossier")")
  echo "# Retrait de $dossier ($(mode_label)) — la base et les pièces jointes sont conservées"
  backup_cmd "$server" "$dossier" "retire-\$(date +%Y%m%d-%H%M%S)"
  remote "$server" "$SUDO service $rc stop $dossier || true"
  remote "$server" "$SUDO sysrc ${rc}_instances-=$dossier && $SUDO rm -f /usr/local/etc/cron.d/partiduo-$dossier"
  remote "$server" "$SUDO rm -f /usr/local/etc/nginx/partiduo/$dossier.conf && $SUDO nginx -t && $SUDO service nginx reload"
  # Le vhost retiré, le renouvellement du certificat échouerait.
  remote "$server" "$SUDO certbot delete --cert-name $dossier.$PARTIDUO_DOMAIN --non-interactive || true"
  local_run "sed -i.bak '/^$dossier[[:space:]]/d' '$INVENTORY' && rm -f '$INVENTORY.bak'"
}

case "$COMMAND" in
  inventory) cmd_inventory "$@" ;;
  provision) cmd_provision "$@" ;;
  status) cmd_status "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  retire) cmd_retire "$@" ;;
  upgrade)
    die "« upgrade » n'existe plus : beryl met les paquets à jour (pkg upgrade), et le script rc.d migre chaque instance à son démarrage (voir deploy/README.adoc)" ;;
  build | upload | rollback | cleanup)
    die "« $COMMAND » n'existe plus : Partiduo est installé par paquet (pkg), voir deploy/README.adoc" ;;
  *) die "commande inconnue : $COMMAND (voir --help)" ;;
esac
