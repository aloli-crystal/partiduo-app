# Instance Partiduo {{DOSSIER}} ({{HOST}}) — généré par partiduo-provision.
#
# Chaque instance pointe sur SA version (lien release/), ce qui permet la
# montée de version progressive du parc (deploy/bin/partiduo-fleet upgrade).

[Unit]
Description=Partiduo — dossier {{DOSSIER}} ({{HOST}})
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User={{SYSTEM_USER}}
Group={{SYSTEM_USER}}
EnvironmentFile={{ENV_FILE}}
WorkingDirectory={{INSTALL_ROOT}}/instances/{{DOSSIER}}
ExecStart={{INSTALL_ROOT}}/instances/{{DOSSIER}}/release/bin/partiduo-server
Restart=on-failure
RestartSec=5

# Durcissement. Pas de PrivateTmp : PostgreSQL est joint par son socket Unix,
# qui peut se trouver dans /tmp.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths={{INSTALL_ROOT}}/instances/{{DOSSIER}}/media

[Install]
WantedBy=multi-user.target
