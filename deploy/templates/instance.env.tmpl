# Environnement de l'instance {{DOSSIER}} ({{HOST}}) — généré par
# partiduo-provision. Contient la clé secrète : mode 640, root:{{SYSTEM_USER}}.
# La configuration d'une instance tient dans son environnement (ADR-001 D2).
MARTEN_ENV=production
MARTEN_SECRET_KEY={{SECRET_KEY}}
MARTEN_ALLOWED_HOSTS={{HOST}}
DATABASE_URL={{DATABASE_URL}}
PARTIDUO_MODULES={{MODULES}}
PARTIDUO_DOMAIN={{DOMAIN}}
PARTIDUO_ASSETS_ROOT={{INSTALL_ROOT}}/instances/{{DOSSIER}}/release/assets
# Stockage des pièces jointes (socle, ADR-006 D1).
PARTIDUO_MEDIA_ROOT={{INSTALL_ROOT}}/instances/{{DOSSIER}}/media
PORT={{PORT}}
