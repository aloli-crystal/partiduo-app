#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# partiduo-provision — crée une instance Partiduo vierge (ADR-001 D2) :
#
#   1. createdb --owner=<rôle> --encoding=UTF8 <base>
#   2. migrations Marten sur cette base
#   3. société (Settings) et jeu de données initial selon le régime
#      (commande `provision`, par Partiduo::Api::Core.provision)
#   4. génération, depuis deploy/templates/, du fichier d'environnement, des
#      vhosts nginx (amorçage ACME puis définitif) et de la tâche cron
#      quotidienne de l'instance, et des commandes d'installation sur un
#      serveur FreeBSD (paquet partiduo-app ou partiduo-app-devel, script
#      rc.d du paquet), dont l'obtention du certificat TLS Let's Encrypt de
#      l'instance par acme.sh (ADR-001 D2 : un certificat par instance ;
#      acme.sh et son cron de renouvellement viennent de la recette beryl
#      `acme`)
#
# Rien n'est installé sur le système : les fichiers générés et les commandes
# d'installation sont écrits dans <sortie>/<dossier>/ (INSTALL.txt). Leur
# installation sur un serveur est le travail de deploy/bin/partiduo-fleet.
#
# Voir `partiduo-provision --help` et deploy/README.adoc.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TEMPLATES="${PARTIDUO_TEMPLATES:-$ROOT/deploy/templates}"

usage() {
  cat <<'EOF'
Usage : partiduo-provision [options] <dossier>

Crée l'instance <dossier> (minuscules, chiffres, tirets), servie en
<dossier>.<domaine>, avec sa base PostgreSQL.

Société :
  --name TEXTE            raison sociale (obligatoire)
  --regime fr|be          régime fiscal (obligatoire) : plan comptable, taux
  --country CC            pays ISO 3166-1 (défaut : selon le régime)
  --locale fr|en|nl       langue par défaut (défaut : fr)
  --vat NUMÉRO            numéro de TVA intracommunautaire
  --siren NUMÉRO          SIREN (régime fr)
  --legal-form TEXTE      forme juridique
  --capital MONTANT       capital social (point décimal)
  --rcs TEXTE             immatriculation (RCS, RPM)
  --street, --street-number, --postcode, --city, --phone, --email TEXTE
  --auth-methods LISTE    méthodes autorisées (défaut : password,passkey)
  --auth-level N          niveau d'authentification minimum, 1 à 3 (défaut : 1)
  --session MINUTES       durée de session (défaut : 480)
  --admin-email ADRESSE   administrateur à inviter

Modules et extensions :
  --modules LISTE         modules activés (défaut : accounting,invoicing)
                          micro-entrepreneur : micro[,invoicing[,accounting]]
                          profession libérale (2035) : liberal[,invoicing[,accounting]]
  --with LISTE            extensions activées (einvoicing,sepa…)

Base et service :
  --domain DOMAINE        domaine du parc (défaut : $PARTIDUO_DOMAIN ou partiduo.localhost)
  --owner RÔLE            propriétaire de la base (défaut : l'utilisateur courant)
  --database NOM          nom de la base (défaut : partiduo_<dossier>)
  --pg-socket RÉP         répertoire du socket PostgreSQL (défaut : /tmp)
  --skip-createdb         la base existe déjà (vide)
  --files-only            fichiers de service seulement, pour une base déjà
                          remplie (restauration dans une instance neuve) :
                          ni createdb, ni migrations, ni société ; nouveau
                          port et nouvelle clé secrète
  --port N                port HTTP local de l'instance (défaut : premier libre dès 8101)
  --version app|devel     paquet qui sert l'instance (défaut : app) : partiduo-app
                          ou partiduo-app-devel ; les deux ont les mêmes emplacements
                          (script rc.d partiduo), seul le nom du paquet change
  --data-dir RÉP          données des instances (défaut : /var/db/partiduo)
  --etc-dir RÉP           fichiers d'environnement (défaut : /usr/local/etc/partiduo)
  --system-user NOM       compte système du service (défaut : partiduo)
  --output-dir RÉP        où écrire les fichiers générés (défaut : ./tmp/instances)

Certificat TLS (Let's Encrypt par acme.sh, un par instance, défi HTTP-01) :
  --acme-email ADRESSE    compte ACME (défaut : $PARTIDUO_ACME_EMAIL ; sans
                          adresse, acme.sh enregistre un compte sans courriel)
  --acme-webroot RÉP      répertoire des défis servi par nginx
                          (défaut : /usr/local/www/letsencrypt)
  --acme-staging          autorité de test de Let's Encrypt (acme.sh --server
                          letsencrypt_test) : n'entame pas le quota de 50
                          certificats par semaine
  --manage COMMANDE       ligne de commande Marten de la distribution
                          (défaut : $PARTIDUO_MANAGE, sinon celle du paquet,
                          /usr/local/bin/partiduo-manage,
                          sinon bin/partiduo-manage, sinon « crystal run manage.cr -- »)

  --dry-run               affiche les étapes sans rien exécuter ni écrire
  -h, --help              cette aide
EOF
}

die() {
  echo "partiduo-provision : $*" >&2
  exit 1
}

# Affiche une commande (citée) puis l'exécute, sauf en --dry-run.
run() {
  printf '+'
  for arg in "$@"; do printf ' %s' "$(quote "$arg")"; done
  printf '\n'
  [ "$DRY_RUN" = 1 ] || "$@"
}

# Citation shell d'un argument, pour l'affichage et INSTALL.txt.
quote() {
  case "$1" in
    '' | *[!A-Za-z0-9_./:=,@%+-]*) printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Remplace les {{CLÉ}} d'un gabarit par les variables d'environnement
# TPL_CLÉ ; échoue si une clé reste sans valeur.
render() {
  template="$1"
  output="$2"
  [ -f "$template" ] || die "gabarit introuvable : $template"
  if [ "$DRY_RUN" = 1 ]; then
    echo "+ gabarit $(basename "$template") -> $output"
    return 0
  fi
  awk '
    {
      line = $0
      while (match(line, /\{\{[A-Z_]+\}\}/)) {
        key = "TPL_" substr(line, RSTART + 2, RLENGTH - 4)
        if (!(key in ENVIRON)) { print "clé sans valeur : " key > "/dev/stderr"; exit 2 }
        printf "%s%s", substr(line, 1, RSTART - 1), ENVIRON[key]
        line = substr(line, RSTART + RLENGTH)
      }
      print line
    }
  ' "$template" >"$output" || die "rendu impossible : $template"
  echo "+ gabarit $(basename "$template") -> $output"
}

secret_key() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  else
    od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
  fi
}

# Premier port libre à partir de 8101, d'après les instances déjà générées
# et celles déjà installées (fichiers d'environnement lisibles de $ETC_DIR).
next_port() {
  max=8100
  for env in "$OUTPUT_DIR"/*/*.env "$ETC_DIR"/*.env; do
    [ -f "$env" ] || continue
    port=$(sed -n 's/^PORT=//p' "$env" | head -n 1)
    case "$port" in '' | *[!0-9]*) continue ;; esac
    [ "$port" -gt "$max" ] && max=$port
  done
  echo $((max + 1))
}

# --- Options -----------------------------------------------------------------

DRY_RUN=0
SKIP_CREATEDB=0
FILES_ONLY=0
DOSSIER=""
MODULES="accounting,invoicing"
EXTENSIONS=""
DOMAIN="${PARTIDUO_DOMAIN:-partiduo.localhost}"
OWNER="${USER:-$(id -un)}"
DATABASE=""
PG_SOCKET="/tmp"
PORT=""
VERSION="app"
DATA_DIR="/var/db/partiduo"
ETC_DIR="/usr/local/etc/partiduo"
SYSTEM_USER="partiduo"
OUTPUT_DIR="./tmp/instances"
MANAGE="${PARTIDUO_MANAGE:-}"
LOCALE=""
PROVISION_ARGS=""
ACME_EMAIL="${PARTIDUO_ACME_EMAIL:-}"
ACME_WEBROOT="/usr/local/www/letsencrypt"
ACME_STAGING=0
# Tâche quotidienne de l'instance (fin de mois de la Facturation, D-INV2-008).
DAILY_COMMAND="invoicing_month_end"

# Ajoute « --option=valeur » aux arguments de la commande `provision`, un par
# ligne (les valeurs peuvent contenir des espaces, pas de saut de ligne).
add_provision_arg() {
  case "$2" in *'
'*) die "valeur sur plusieurs lignes refusée pour $1" ;; esac
  PROVISION_ARGS="$PROVISION_ARGS
$1=$2"
}

need_value() {
  [ $# -ge 2 ] || die "option $1 : valeur manquante"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --dry-run) DRY_RUN=1 ;;
    --skip-createdb) SKIP_CREATEDB=1 ;;
    --files-only) FILES_ONLY=1 ;;
    --acme-staging) ACME_STAGING=1 ;;
    --*=*)
      option="${1%%=*}"
      value="${1#*=}"
      shift
      set -- "$option" "$value" "$@"
      continue
      ;;
    --name | --regime | --country | --vat | --siren | --legal-form | --capital | --rcs | --street | \
      --street-number | --postcode | --city | --phone | --email | --auth-methods | --auth-level | \
      --session | --admin-email)
      need_value "$@"
      add_provision_arg "$1" "$2"
      shift
      ;;
    --locale) need_value "$@"; LOCALE="$2"; add_provision_arg "$1" "$2"; shift ;;
    --modules) need_value "$@"; MODULES="$2"; shift ;;
    --with) need_value "$@"; EXTENSIONS="$2"; shift ;;
    --domain) need_value "$@"; DOMAIN="$2"; shift ;;
    --owner) need_value "$@"; OWNER="$2"; shift ;;
    --database) need_value "$@"; DATABASE="$2"; shift ;;
    --pg-socket) need_value "$@"; PG_SOCKET="$2"; shift ;;
    --port) need_value "$@"; PORT="$2"; shift ;;
    --version) need_value "$@"; VERSION="$2"; shift ;;
    --data-dir) need_value "$@"; DATA_DIR="$2"; shift ;;
    --etc-dir) need_value "$@"; ETC_DIR="$2"; shift ;;
    --system-user) need_value "$@"; SYSTEM_USER="$2"; shift ;;
    --output-dir) need_value "$@"; OUTPUT_DIR="$2"; shift ;;
    --manage) need_value "$@"; MANAGE="$2"; shift ;;
    --acme-email) need_value "$@"; ACME_EMAIL="$2"; shift ;;
    --acme-webroot) need_value "$@"; ACME_WEBROOT="$2"; shift ;;
    -*) die "option inconnue : $1 (voir --help)" ;;
    *)
      [ -z "$DOSSIER" ] || die "un seul dossier à la fois ($DOSSIER, $1)"
      DOSSIER="$1"
      ;;
  esac
  shift
done

[ -n "$DOSSIER" ] || { usage >&2; exit 1; }

# --- Contrôles -----------------------------------------------------------------

printf '%s' "$DOSSIER" | grep -Eq '^[a-z][a-z0-9-]{0,39}$' ||
  die "nom de dossier invalide : « $DOSSIER » (minuscule en tête, puis minuscules, chiffres, tirets ; 40 caractères au plus)"
case "$DOSSIER" in *-) die "nom de dossier invalide : « $DOSSIER » (tiret final)" ;; esac

printf '%s' "$DOMAIN" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$' ||
  die "domaine invalide : « $DOMAIN »"

[ -n "$DATABASE" ] || DATABASE="partiduo_$(printf '%s' "$DOSSIER" | tr '-' '_')"
printf '%s' "$DATABASE" | grep -Eq '^[a-z_][a-z0-9_]{0,62}$' || die "nom de base invalide : « $DATABASE »"
printf '%s' "$OWNER" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]*$' || die "rôle PostgreSQL invalide : « $OWNER »"

for code in $(printf '%s' "$MODULES,$EXTENSIONS" | tr ',' ' '); do
  printf '%s' "$code" | grep -Eq '^[a-z][a-z0-9_]*$' || die "code de module ou d'extension invalide : « $code »"
done

if [ -n "$ACME_EMAIL" ]; then
  # Caractères sûrs seulement : l'adresse passe dans la commande que su(1)
  # confie au shell de l'utilisateur acme (INSTALL.txt).
  printf '%s' "$ACME_EMAIL" | grep -Eq '^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$' ||
    die "adresse ACME invalide : « $ACME_EMAIL »"
fi
printf '%s' "$ACME_WEBROOT" | grep -Eq '^/[A-Za-z0-9_./-]*$' || die "répertoire ACME invalide : « $ACME_WEBROOT »"

# Paquet qui sert l'instance : partiduo-app ou partiduo-app-devel, exclusifs
# l'un de l'autre et installés aux mêmes emplacements (aloli-ports,
# finance/partiduo-app) ; seul le nom du paquet dépend de la version.
case "$VERSION" in
  app) PACKAGE=partiduo-app ;;
  devel) PACKAGE=partiduo-app-devel ;;
  *) die "version invalide : « $VERSION » (app ou devel)" ;;
esac
RC_NAME=partiduo
PACKAGE_MANAGE=/usr/local/lib/partiduo/bin/partiduo-manage
printf '%s' "$DATA_DIR" | grep -Eq '^/[A-Za-z0-9_./-]*$' || die "répertoire de données invalide : « $DATA_DIR »"
printf '%s' "$ETC_DIR" | grep -Eq '^/[A-Za-z0-9_./-]*$' || die "répertoire d'environnement invalide : « $ETC_DIR »"

if [ -z "$PORT" ]; then PORT=$(next_port); fi
case "$PORT" in '' | *[!0-9]*) die "port invalide : « $PORT »" ;; esac
[ "$PORT" -ge 1024 ] && [ "$PORT" -le 65535 ] || die "port hors limites : $PORT"

if [ -z "$MANAGE" ]; then
  if [ -x /usr/local/bin/partiduo-manage ]; then
    MANAGE=/usr/local/bin/partiduo-manage
  elif [ -x "$ROOT/bin/partiduo-manage" ]; then
    MANAGE="$ROOT/bin/partiduo-manage"
  else
    MANAGE="crystal run $ROOT/manage.cr --"
  fi
fi

HOST="$DOSSIER.$DOMAIN"
DATABASE_URL="postgres:///$DATABASE?host=$PG_SOCKET"
# createdb et les outils libpq passent par le même socket Unix que l'instance.
export PGHOST="$PG_SOCKET"
ACTIVE="$MODULES"
[ -z "$EXTENSIONS" ] || ACTIVE="${ACTIVE:+$ACTIVE,}$EXTENSIONS"
[ -n "$ACTIVE" ] || ACTIVE="none"
INSTANCE_DIR="$OUTPUT_DIR/$DOSSIER"

echo "== Instance $DOSSIER : https://$HOST/ (base $DATABASE, modules $ACTIVE, port $PORT, paquet $PACKAGE)"

# --- 1. Base -------------------------------------------------------------------

if [ "$FILES_ONLY" = 1 ]; then
  echo "== 1 à 3. Base $DATABASE déjà remplie (--files-only) : ni createdb, ni migrations, ni société"
elif [ "$SKIP_CREATEDB" = 1 ]; then
  echo "== 1. Base : $DATABASE existante (--skip-createdb)"
else
  echo "== 1. Base"
  run env PGHOST="$PG_SOCKET" createdb --owner="$OWNER" --encoding=UTF8 "$DATABASE"
fi

# --- 2. Migrations -------------------------------------------------------------

export DATABASE_URL
export PARTIDUO_MODULES="$ACTIVE"
export PARTIDUO_DOMAIN="$DOMAIN"
if [ "$FILES_ONLY" = 0 ]; then
  echo "== 2. Migrations"
  # shellcheck disable=SC2086 # $MANAGE est une ligne de commande
  run $MANAGE migrate
fi

# --- 3. Société et jeu de données initial --------------------------------------

if [ "$FILES_ONLY" = 0 ]; then
  echo "== 3. Société et jeu de données initial"
  set -- --domain="$HOST" --modules="$MODULES"
  [ -z "$EXTENSIONS" ] || set -- "$@" --with="$EXTENSIONS"
  OLD_IFS=$IFS
  IFS='
'
  for arg in $PROVISION_ARGS; do
    [ -n "$arg" ] && set -- "$@" "$arg"
  done
  IFS=$OLD_IFS
  # shellcheck disable=SC2086
  run $MANAGE provision "$@"
fi

# --- 4. Fichiers de service ----------------------------------------------------

echo "== 4. Fichiers de service ($INSTANCE_DIR)"
if [ "$DRY_RUN" = 1 ]; then
  TPL_SECRET_KEY="(généré)"
else
  mkdir -p "$INSTANCE_DIR"
  TPL_SECRET_KEY=$(secret_key)
fi

TPL_DOSSIER="$DOSSIER"
TPL_HOST="$HOST"
TPL_DOMAIN="$DOMAIN"
TPL_PORT="$PORT"
TPL_DATABASE_URL="$DATABASE_URL"
TPL_MODULES="$ACTIVE"
TPL_LOCALE="${LOCALE:-fr}"
TPL_DATA_DIR="$DATA_DIR"
TPL_PACKAGE="$PACKAGE"
TPL_MANAGE_PATH="$PACKAGE_MANAGE"
TPL_DAILY_COMMAND="$DAILY_COMMAND"
TPL_DAILY_MINUTE=$((PORT % 60))
TPL_ETC_DIR="$ETC_DIR"
TPL_ENV_FILE="$ETC_DIR/$DOSSIER.env"
TPL_SYSTEM_USER="$SYSTEM_USER"
TPL_ACME_WEBROOT="$ACME_WEBROOT"
export TPL_SECRET_KEY TPL_DOSSIER TPL_HOST TPL_DOMAIN TPL_PORT TPL_DATABASE_URL TPL_MODULES TPL_LOCALE \
  TPL_DATA_DIR TPL_PACKAGE TPL_MANAGE_PATH TPL_DAILY_COMMAND TPL_DAILY_MINUTE TPL_ETC_DIR TPL_ENV_FILE \
  TPL_SYSTEM_USER TPL_ACME_WEBROOT

OLD_UMASK=$(umask)
umask 077
render "$TEMPLATES/instance.env.tmpl" "$INSTANCE_DIR/$DOSSIER.env"
umask "$OLD_UMASK"
render "$TEMPLATES/nginx-acme.conf.tmpl" "$INSTANCE_DIR/$DOSSIER.acme.nginx.conf"
render "$TEMPLATES/nginx-vhost.conf.tmpl" "$INSTANCE_DIR/$DOSSIER.nginx.conf"
render "$TEMPLATES/partiduo-instance.cron.tmpl" "$INSTANCE_DIR/partiduo-$DOSSIER.cron"

# Certificat de l'instance, par acme.sh selon les conventions du port FreeBSD
# security/acme.sh (recette beryl `acme`) : acme.sh tourne sous l'utilisateur
# `acme` (su -m), jamais en root ; home /var/db/acme/.acme.sh, celui du cron
# de renouvellement (/usr/local/etc/cron.d/acme) ; certificat laissé dans
# CERT_HOME (/var/db/acme/certs/<hôte>_ecc/, clé EC), où le vhost le lit ;
# nginx rechargé par sudo (règle /usr/local/etc/sudoers.d/acme, chemins
# absolus : le PATH du cron est limité). Autorité de production ou de test,
# compte ACME avec adresse éventuel. Un certificat encore valide n'est pas
# réémis (acme.sh --issue rend 2) : rejouer l'installation n'entame pas le
# quota Let's Encrypt du domaine.
ACME_SH=/usr/local/sbin/acme.sh
ACME_USER=acme
ACME_HOME=/var/db/acme/.acme.sh
ACME_CERT_HOME=/var/db/acme/certs
ACME_CERT_DIR="$ACME_CERT_HOME/${HOST}_ecc"
ACME_SUDOERS=/usr/local/etc/sudoers.d/acme
ACME_RELOADCMD="/usr/local/bin/sudo /usr/sbin/service nginx reload"
if [ "$ACME_STAGING" = 1 ]; then
  ACME_SERVER=letsencrypt_test
else
  ACME_SERVER=letsencrypt
fi
ACME_ACCOUNT=""
[ -z "$ACME_EMAIL" ] ||
  ACME_ACCOUNT="su -m $ACME_USER -c \"$ACME_SH --register-account -m $(quote "$ACME_EMAIL") --server $ACME_SERVER --home $ACME_HOME\"
"
echo "+ certificat Let's Encrypt pour $HOST ($([ "$ACME_STAGING" = 1 ] && echo 'autorité de test' || echo 'production'))"

INSTALL="$INSTANCE_DIR/INSTALL.txt"
if [ "$DRY_RUN" = 0 ]; then
  cat >"$INSTALL" <<EOF
# Installation de l'instance $DOSSIER ($HOST) — à exécuter sur le serveur,
# en root, depuis ce répertoire (sh INSTALL.txt). partiduo-provision ne l'a
# PAS fait. Le certificat TLS est propre à l'instance (ADR-001 D2) : le vhost
# d'amorçage sert le défi ACME, acme.sh (utilisateur $ACME_USER, conventions
# du port FreeBSD) obtient le certificat dans $ACME_CERT_HOME, puis le vhost
# définitif le remplace ; le cron d'acme.sh (/usr/local/etc/cron.d/acme,
# recette beryl \`acme\`) le renouvelle. Quota : 50 certificats par semaine
# pour le domaine.
set -eu
# Prérequis, vérifiés avant toute modification : acme.sh installé selon les
# conventions du port (recette beryl \`acme\` : utilisateur $ACME_USER, règle
# sudo de rechargement de nginx) et nginx lit les vhosts des instances.
if [ ! -x $ACME_SH ]; then
  echo "$ACME_SH absent : installez acme.sh (recette beryl « acme »), puis relancez." >&2
  exit 1
fi
if ! id $ACME_USER >/dev/null 2>&1 || [ ! -f $ACME_SUDOERS ]; then
  echo "utilisateur $ACME_USER ou $ACME_SUDOERS absent : appliquez la recette beryl « acme », puis relancez." >&2
  exit 1
fi
if ! grep -Eq '^[[:space:]]*include[[:space:]]+partiduo/\*\.conf;' /usr/local/etc/nginx/nginx.conf; then
  echo "nginx.conf : ajoutez « include partiduo/*.conf; » dans le bloc http, puis relancez." >&2
  exit 1
fi
install -d -o root -g $SYSTEM_USER -m 750 $ETC_DIR
install -o root -g $SYSTEM_USER -m 640 $DOSSIER.env $ETC_DIR/$DOSSIER.env
install -d -o $SYSTEM_USER -g $SYSTEM_USER -m 750 $DATA_DIR/$DOSSIER $DATA_DIR/$DOSSIER/media /var/log/partiduo
# Service : script rc.d du paquet $PACKAGE, une instance de plus.
case " \$(sysrc -n ${RC_NAME}_instances 2>/dev/null || true) " in
  *" $DOSSIER "*) ;;
  *) sysrc ${RC_NAME}_instances+=" $DOSSIER" ;;
esac
sysrc ${RC_NAME}_enable=YES
service $RC_NAME start $DOSSIER
# Tâches quotidiennes (cron(8), champ utilisateur).
install -d -m 755 /usr/local/etc/cron.d
install -m 644 partiduo-$DOSSIER.cron /usr/local/etc/cron.d/partiduo-$DOSSIER
# Certificat : vhost d'amorçage (défi HTTP-01), acme.sh, vhost définitif.
# Les défis sont écrits par acme.sh : le webroot appartient à $ACME_USER.
install -d -o $ACME_USER -g $ACME_USER -m 755 $ACME_WEBROOT
install -d -m 755 /usr/local/etc/nginx/partiduo
install -m 644 $DOSSIER.acme.nginx.conf /usr/local/etc/nginx/partiduo/$DOSSIER.conf
test -f $ACME_CERT_DIR/fullchain.cer || { nginx -t && service nginx reload; }
${ACME_ACCOUNT}rc=0
su -m $ACME_USER -c "$ACME_SH --issue --server $ACME_SERVER -d $HOST -w $ACME_WEBROOT --home $ACME_HOME --cert-home $ACME_CERT_HOME --keylength ec-256" || rc=\$?
# 0 : émis ; 2 : encore valide, rien à faire ; sinon : échec.
if [ "\$rc" != 0 ] && [ "\$rc" != 2 ]; then
  echo "acme.sh --issue : échec (code \$rc, journal /var/log/acme.sh.log)" >&2
  exit "\$rc"
fi
# Sans copie : le certificat reste dans CERT_HOME, où le vhost le lit ;
# acme.sh enregistre le reloadcmd, que son cron rejoue à chaque renouvellement.
su -m $ACME_USER -c "$ACME_SH --install-cert -d $HOST --ecc --home $ACME_HOME --cert-home $ACME_CERT_HOME \\
  --reloadcmd '$ACME_RELOADCMD'"
install -m 644 $DOSSIER.nginx.conf /usr/local/etc/nginx/partiduo/$DOSSIER.conf
nginx -t && service nginx reload
EOF
fi
echo "+ instructions d'installation -> $INSTALL"

echo "== Instance $DOSSIER provisionnée$([ "$DRY_RUN" = 1 ] && echo ' (simulation)')."
